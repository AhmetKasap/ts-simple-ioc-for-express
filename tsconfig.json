{
    "compilerOptions": {
      "target": "ESNext",
      "module": "commonjs",
      "rootDir": "src",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "emitDecoratorMetadata": true, //important
      "experimentalDecorators": true, //important
      "skipLibCheck": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "types": ["node", "express"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }
  